# The Syndicate Accord app environment
# Copy to .env.local for local dev. NEVER commit .env.local or real secrets.
# See ../plan/APPLIED-DECISIONS.md and ../plan/01-architecture-and-hosting.md

# Supabase (server-only; service role bypasses RLS by design per plan)
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# DEV ONLY: skip Supabase with an in-memory store for local UI/auth flow testing.
# Never use in production. Data resets on restart; no DB constraints/RLS/RPCs.
# DEV_NO_DB=true


# Session signing (256-bit random secret)
SESSION_SECRET=

# Read-only projector token for /arena/data (unguessable)
ARENA_TOKEN=

# Game wardens/admin portal (A8): hidden path segment/token NOT shown on main portal + admin login required.
# Use an unguessable value in real deployments; keep it server-checked.
ADMIN_PORTAL_SECRET_PATH=
# Bootstrap admin (seed on first setup only). Change password before any shared/staging/production use.
ADMIN_BOOTSTRAP_USERNAME=Arsh
ADMIN_BOOTSTRAP_PASSWORD=

# Event config overrides (A5)
EVENT_TIMEZONE=Asia/Dubai
EVENT_START_AT=2026-11-16T00:00:00+04:00
EVENT_WEEKEND_START_AT=2026-11-21T00:00:00+04:00
EVENT_CLOSING_AT=2026-11-23T00:00:00+04:00
EVENT_LOCK_AT=
